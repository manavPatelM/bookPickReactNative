{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_PUBLIC_API_URL": "https://backendforbookpick.onrender.com/"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_PUBLIC_API_URL": "https://backendforbookpick.onrender.com/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
